service teeregistry-1-0 /vendor/bin/hw/vendor.trustonic.teeregistry@1.0-service
    interface vendor.trustonic.teeregistry@1.0::ITeeRegistry default
    user root
    group root system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/system/lib64/hw:/sbin
    disabled
    seclabel u:r:recovery:s0

