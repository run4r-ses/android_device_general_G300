import /init.recovery.usb.rc
import /vendor/etc/init/trustonic.rc
import /vendor/etc/init/android.hardware.boot@1.0-service.rc
import /vendor/etc/init/android.hardware.gatekeeper@1.0-service.rc
import /vendor/etc/init/android.hardware.keymaster@4.0-service.trustonic.rc
import /vendor/etc/init/android.hardware.vibrator@1.0-service.rc
import /vendor/etc/init/vendor.trustonic.tee@1.0-service.rc
import /vendor/etc/init/vendor.trustonic.teeregistry@1.0-service.rc

on early-init
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw:/system/lib64/hw

    # Create mountpoint for persist partition required by Trustonic TEE
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/persist 0771 system system
    mkdir /mnt/vendor/nvdata 0771 system system
    mkdir /mnt/vendor/nvcfg 0771 system system
    mkdir /mnt/vendor/protect_f 0771 system system
    mkdir /mnt/vendor/protect_s 0771 system system

on fs
    install_keyring
    # Ensure bootdevice symlink exists
    wait /dev/block/platform/mtk-msdc.0/11230000.msdc0
    symlink /dev/block/platform/mtk-msdc.0/11230000.msdc0 /dev/block/platform/bootdevice

    # Distinguish USB connection (CDP vs SDP)
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

    # Mount persist for Trustonic MobiCore registry
    mount ext4 /dev/block/platform/bootdevice/by-name/persist /mnt/vendor/persist noatime nosuid nodev commit=1
    chown system system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon /mnt/vendor/persist
    mkdir /mnt/vendor/persist/mcRegistry 0771 system system
    symlink /mnt/vendor/persist /vendor/persist

    # Trustonic TEE device node permissions
    chmod 0600 /dev/mobicore
    chown system system /dev/mobicore
    chmod 0666 /dev/mobicore-user
    chown system system /dev/mobicore-user
    chmod 0666 /dev/t-base-tui
    chown system system /dev/t-base-tui

on post-fs
    # Support A/B feature for eMMC boot region
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

    start vendor.boot-hal-1-0
    start vendor.vibrator-1-0

on post-fs-data
    mkdir /data/vendor 0775 system system
    mkdir /data/vendor/mcRegistry 0775 system system
    mkdir /data/vendor/key_provisioning 0771 system system

on boot
    start health-hal-2-0

on property:hwservicemanager.ready=true
    write /proc/bootprof "MOBICORE: Starting mcDriverDaemon"
    start mobicore
    start tee-1-0
    start teeregistry-1-0
    start vendor.keymaster-4-0-trustonic
    start vendor.gatekeeper-1-0

on property:ro.crypto.state=unsupported
    stop mobicore
    stop tee-1-0
    stop teeregistry-1-0
    stop vendor.keymaster-4-0-trustonic
    stop vendor.gatekeeper-1-0

on property:ro.crypto.state=unencrypted
    stop mobicore
    stop tee-1-0
    stop teeregistry-1-0
    stop vendor.keymaster-4-0-trustonic
    stop vendor.gatekeeper-1-0

on property:twrp.decrypt.done=true
    stop mobicore
    stop tee-1-0
    stop teeregistry-1-0
    stop vendor.keymaster-4-0-trustonic
    stop vendor.gatekeeper-1-0

